# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
public
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# Vite's application-owned public assets are source files. Keep the generated
# repository-root /public output ignored, but commit the frontend source assets
# that Vite copies into it during deployment. PNG/JPEG source exports are
# retained locally as design masters; production uses their optimized WebP
# equivalents (plus the explicitly retained Open Graph image).
!/artifacts/frontend/public/
!/artifacts/frontend/public/**
/artifacts/frontend/public/**/*.png
/artifacts/frontend/public/*.jpeg
/artifacts/frontend/public/hero-ref.jpg

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/test-results
/playwright-report
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.agents/
.config/
.local/

.vercel/
.env*
!.env.example
