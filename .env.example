# Core runtime
NODE_ENV=development
PORT=8080
FRONTEND_PORT=5173
API_ORIGIN=http://127.0.0.1:8080
# Application traffic. On Vercel use the Supabase transaction-pooler URL
# (port 6543, sslmode=require). Keep the pool at 1 per serverless instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shiprion
DATABASE_POOL_MAX=10
# Migrations need a direct or session-pooler connection (port 5432).
MIGRATION_DATABASE_URL=
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:5173
# Vercel automatically sends this as a bearer token to the email cron route.
CRON_SECRET=

# Email (Brevo SMTP or any authenticated SMTP service)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SUPPORT_EMAIL=support@example.com
FROM_EMAIL=support@shiprion.com

# Private S3-compatible proof-of-delivery storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional geocoding provider
GOOGLE_MAPS_API_KEY=

# Explicit, opt-in local sample data only
SEED_DEVELOPMENT=false
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# One-time production admin bootstrap (run the command, then remove these)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
